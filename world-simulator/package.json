{
  "name": "drusniel-world-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone offline World Simulator for Drusniel: Azgaar audit, NPC budget and pilot selection.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "start": "node backend/src/server.js --serve-frontend",
    "audit": "node backend/src/cli/audit.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test \"backend/tests/**/*.test.js\"",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "lint": "eslint .",
    "build": "vite build --config frontend/vite.config.js"
  },
  "dependencies": {
    "js-yaml": "4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
